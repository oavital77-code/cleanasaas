# 🔴 Clerk — מערכת הזהות (login/signup). בלעדיהם האפליקציה לא עולה בכלל
# (ClerkProvider ב-app/layout.tsx + clerkMiddleware). @clerk/nextjs קורא
# אותם אוטומטית מה-env — לא מועברים בקוד. מ-Clerk Dashboard → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (פרויקט אחד לכל הפלטפורמה — כל הקליניקות חולקות אותו DB, מבודדות ב-clinic_id + RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# WooCommerce לכל קליניקה מוזן דרך /admin/settings (טבלת clinic_payment_settings),
# לא כאן. אין יותר משתני סביבה גלובליים ל-Woo — ר' baclinica-spec המקורי לעומת
# SAASMIGRATIONSPEC סעיף 6.

# תשלומי הפלטפורמה עצמה (platform_subscriptions) — PayPlus. שלושת המפתחות
# חובה כדי שכפתור "הפעלת מנוי" יעבוד; בלעדיהם המסך מציג "תשלומים עדיין לא
# זמינים" והניסיון/ההשעיה ממשיכים לעבוד כרגיל. קודם סנדבוקס (restapidev),
# ואז מוחקים את PAYPLUS_BASE_URL כדי לעבור לפרודקשן.
PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
PAYPLUS_PAYMENT_PAGE_UID=
# PAYPLUS_BASE_URL=https://restapidev.payplus.co.il/api/v1.0
# מחיר המנוי החודשי בש"ח כולל מע"מ. ברירת מחדל בקוד: 209 (החלטת 8.9.2026).
# PLATFORM_PLAN_PRICE_ILS=209

# כתובת בסיס לקישורי מייל/ICS
NEXT_PUBLIC_APP_URL=https://app.cleana.co.il

# 🔴 חובה. Vercel Cron שולח את הערך הזה ככותרת Authorization: Bearer <...>
# בכל הפעלה מתוזמנת, ו-lib/cron/guard.ts דוחה כל בקשה בלי הכותרת הנכונה.
# ה-routes האלה רצים עם service role וכותבים על פני כל הקליניקות, ולכן בלי
# המשתנה הזה הם מחזירים 503 ולא רצים בכלל (fail closed במכוון).
# ליצירה: openssl rand -base64 32
CRON_SECRET=

# Sentry — ניטור שגיאות בפרודקשן. בלי ערך — לא מופעל בכלל.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Clerk webhook (app/api/webhooks/clerk/route.ts) — user.deleted בלבד
# (ר' ההערה בקובץ למה לא user.created). נוצר ב-Clerk Dashboard → Webhooks
# → Add Endpoint, עם ה-URL של ה-route הזה; Clerk נותן את הערך הזה
# בבחירת ה-endpoint. @clerk/nextjs/webhooks קורא אותו אוטומטית — לא צריך
# להעביר אותו בקוד.
CLERK_WEBHOOK_SIGNING_SECRET=
